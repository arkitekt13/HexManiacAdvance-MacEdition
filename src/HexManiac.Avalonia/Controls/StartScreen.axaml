<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="clr-namespace:HavenSoft.HexManiac.AvaloniaUI"
      xmlns:hsv="clr-namespace:HavenSoft.HexManiac.AvaloniaUI.Resources"
      x:Class="HavenSoft.HexManiac.AvaloniaUI.Controls.StartScreen"
      Background="#19181F" RowDefinitions="*,Auto,Auto">
   <Grid.Styles>
      <Style Selector="Button.welcomeOpen">
         <Setter Property="Background" Value="#9970CE"/>
         <Setter Property="Foreground" Value="White"/>
         <Setter Property="BorderThickness" Value="0"/>
         <Setter Property="BorderBrush" Value="Transparent"/>
         <Setter Property="CornerRadius" Value="9"/>
         <Setter Property="HorizontalContentAlignment" Value="Center"/>
      </Style>
      <Style Selector="Button.welcomeOpen:pointerover /template/ Border#WelcomeButtonSurface">
         <Setter Property="Background" Value="#AE86E1"/>
      </Style>
      <Style Selector="Button.welcomeOpen:pressed /template/ Border#WelcomeButtonSurface">
         <Setter Property="Background" Value="#805AB5"/>
      </Style>
      <Style Selector="Button.welcomeOpen:focus-visible /template/ Border#WelcomeButtonSurface">
         <Setter Property="BorderBrush" Value="#E2CAFF"/>
      </Style>
      <Style Selector="Button.welcomeLink">
         <Setter Property="Background" Value="Transparent"/>
         <Setter Property="Foreground" Value="#BBA6D5"/>
         <Setter Property="BorderThickness" Value="0"/>
         <Setter Property="Padding" Value="2,0"/>
         <Setter Property="MinHeight" Value="20"/>
         <Setter Property="VerticalContentAlignment" Value="Center"/>
         <Setter Property="FontSize" Value="13"/>
         <Setter Property="Template">
            <ControlTemplate TargetType="Button">
               <Border Name="WelcomeLinkSurface" Background="Transparent" BorderBrush="Transparent"
                       BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                  <ContentPresenter Name="LinkContent" Content="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                     <ContentPresenter.ContentTemplate>
                        <DataTemplate>
                           <TextBlock Text="{Binding}" TextDecorations="Underline"/>
                        </DataTemplate>
                     </ContentPresenter.ContentTemplate>
                  </ContentPresenter>
               </Border>
            </ControlTemplate>
         </Setter>
      </Style>
      <Style Selector="Button.welcomeLink:pointerover">
         <Setter Property="Foreground" Value="#E2CAFF"/>
      </Style>
      <Style Selector="Button.welcomeLink:pressed">
         <Setter Property="Foreground" Value="#AE86E1"/>
      </Style>
      <Style Selector="Button.welcomeLink:focus-visible /template/ Border#WelcomeLinkSurface">
         <Setter Property="BorderBrush" Value="#E2CAFF"/>
      </Style>
   </Grid.Styles>

   <!-- Scale lettering down for smaller windows while keeping the action button at a usable size. -->
   <Grid Margin="28,16,28,0">
      <Ellipse Width="760" Height="360" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Ellipse.Fill>
            <RadialGradientBrush>
               <GradientStop Color="#187E4CB3" Offset="0"/>
               <GradientStop Color="#007E4CB3" Offset="1"/>
            </RadialGradientBrush>
         </Ellipse.Fill>
      </Ellipse>
      <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" VerticalAlignment="Center">
         <Viewbox MaxWidth="720" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
            <StackPanel Width="720" Margin="12,8">
               <TextBlock Name="WelcomeTitle" Text="HexManiacAdvance" FontSize="54" FontWeight="Bold"
                          FontFamily="Inter, Helvetica Neue, sans-serif" Foreground="#B997EA"
                          HorizontalAlignment="Center" TextAlignment="Center"/>
               <TextBlock Name="MacSubtitle" Text="Mac Edition" FontSize="27" FontWeight="Light" Margin="0,4,0,0"
                          FontFamily="Inter, Helvetica Neue, sans-serif" Foreground="#F5F2F9"
                          HorizontalAlignment="Center"/>
            </StackPanel>
         </Viewbox>
         <StackPanel Name="WelcomeCredits" Spacing="0" Margin="0,0,0,20" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
               <TextBlock Text="Developed By:" FontWeight="Bold" FontSize="13" Foreground="#A39BAE" VerticalAlignment="Center"/>
               <Button Name="DeveloperLink" Classes="welcomeLink" Content="Haven" Tag="https://github.com/haven1433" Click="Navigate"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
               <TextBlock Text="Ported By:" FontWeight="Bold" FontSize="13" Foreground="#A39BAE" VerticalAlignment="Center"/>
               <Button Name="PortAuthorLink" Classes="welcomeLink" Content="xavierkeys" Tag="https://github.com/xavierkeys" Click="Navigate"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
               <TextBlock Text="Forked By:" FontWeight="Bold" FontSize="13" Foreground="#A39BAE" VerticalAlignment="Center"/>
               <Button Name="ForkAuthorLink" Classes="welcomeLink" Content="arkitekt13" Tag="https://github.com/arkitekt13" Click="Navigate"/>
            </StackPanel>
         </StackPanel>
         <Button Name="OpenFileButton" Classes="welcomeOpen" Command="{Binding Open}"
                 Width="182" Height="46" HorizontalAlignment="Center"
                 AutomationProperties.Name="Open ROM file">
            <Button.Template>
               <ControlTemplate TargetType="Button">
                  <Border Name="WelcomeButtonSurface" Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="1"
                          BorderBrush="{TemplateBinding BorderBrush}">
                     <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                       ContentTemplate="{TemplateBinding ContentTemplate}"
                                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  </Border>
               </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
               <Path Width="18" Height="18" Stretch="Uniform" Fill="White" Data="{hsv:Icon Open}"/>
               <TextBlock Text="Open ROM" FontSize="15" VerticalAlignment="Center"/>
            </StackPanel>
         </Button>
         <TextBlock Text="⌘O  ·  or drop a ROM here" Foreground="#85808F" FontSize="12"
                    HorizontalAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
   </Grid>
   <Border Name="WelcomeError" Grid.Row="1" IsVisible="{Binding ShowError, FallbackValue=False}"
           Background="#28212F" BorderBrush="#674D77" BorderThickness="1" CornerRadius="8"
           MaxWidth="620" Padding="14" Margin="28,12,28,0" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto">
         <TextBlock Text="{Binding ErrorMessage}" Foreground="#EACDEB" TextWrapping="Wrap"
                    VerticalAlignment="Center" Margin="0,0,12,0"/>
         <Button Grid.Column="1" Content="Dismiss" Command="{Binding ClearError}"/>
      </Grid>
   </Border>
   <StackPanel Grid.Row="2" Margin="20,12,20,16" Spacing="8" HorizontalAlignment="Center">
      <StackPanel Name="WelcomeLinks" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
         <Button Name="MacHelpLink" Classes="welcomeLink" Content="Mac Help" Tag="{x:Static app:AppIdentity.MacHelpUrl}" Click="Navigate"/>
         <TextBlock Text="·" Foreground="#85808F" VerticalAlignment="Center"/>
         <Button Name="ReportIssueLink" Classes="welcomeLink" Content="Report an Issue" Tag="{x:Static app:AppIdentity.IssuesUrl}" Click="Navigate"/>
         <TextBlock Text="·" Foreground="#85808F" VerticalAlignment="Center"/>
         <Button Name="RepositoryLink" Classes="welcomeLink" Content="GitHub" Tag="{x:Static app:AppIdentity.RepositoryUrl}" Click="Navigate"/>
      </StackPanel>
      <TextBlock Name="VersionInformation" Foreground="#85808F" FontSize="11"
                 HorizontalAlignment="Center" TextAlignment="Center" Margin="0"/>
   </StackPanel>
</Grid>
