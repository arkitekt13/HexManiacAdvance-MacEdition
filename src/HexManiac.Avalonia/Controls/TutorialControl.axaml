<!--
   Ported from HexManiac.WPF/Controls/TutorialControl.xaml.

   The Canvas.Style DataTrigger that hid the whole control at 100% completion becomes a bound
   IsVisible; the ItemContainerStyle that positioned each card via Canvas.Top becomes a
   container-level style, with completed-card movement driven from code-behind.
   Hover expands the layout width instead of moving content outside a narrow hit-test area.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HavenSoft.HexManiac.AvaloniaUI.Controls.TutorialControl"
             xmlns:res="clr-namespace:HavenSoft.HexManiac.AvaloniaUI.Resources"
             xmlns:local="clr-namespace:HavenSoft.HexManiac.AvaloniaUI.Controls">
   <Canvas ClipToBounds="False" Width="72" Height="400" Name="ContentPanel" HorizontalAlignment="Left"
           Background="Transparent"
           IsVisible="{Binding CompletionPercent, Converter={x:Static res:NotEqualConverter.Instance}, ConverterParameter=100.00%}">
      <Canvas.Resources>
         <res:IconConverter x:Key="IconConverter" />
      </Canvas.Resources>
      <Border Name="CardsViewport" Width="{Binding #ContentPanel.Width}" Height="400" ClipToBounds="True">
      <ItemsControl Name="Tutorials" ItemsSource="{Binding Tutorials}" Width="320" Height="400"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
         <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><Canvas ClipToBounds="True" /></ItemsPanelTemplate>
         </ItemsControl.ItemsPanel>
         <!--
            WPF set Canvas.Top and Visibility through an ItemContainerStyle. They have to stay on
            the container: a Canvas positions the generated ContentPresenter, so the same
            attached properties written inside the ItemTemplate would leave every card at y=0.
         -->
         <ItemsControl.Styles>
            <Style Selector="ItemsControl#Tutorials > ContentPresenter">
               <Setter Property="Canvas.Top" Value="{Binding TargetPosition, Converter={x:Static local:TutorialControl.RowOffsetConverter}}" />
               <Setter Property="Canvas.Left" Value="0" />
               <Setter Property="IsVisible" Value="{Binding Incomplete}" />
            </Style>
         </ItemsControl.Styles>
         <ItemsControl.ItemTemplate>
            <!-- Compact cards retain readable text while using a smaller icon column. -->
            <DataTemplate>
               <Border BorderThickness="1" BorderBrush="{DynamicResource Secondary}" Background="{DynamicResource Backlight}"
                       PointerEntered="OnEnterTutorial">
                  <Canvas Width="318" Height="78">
                     <Decorator Width="70" Height="50" Canvas.Top="22">
                        <Path Data="{Binding Icon, Converter={StaticResource IconConverter}}" Stretch="Uniform" Margin="12,2,12,10" Fill="{DynamicResource Secondary}" />
                     </Decorator>
                     <TextBlock FontWeight="Bold" FontSize="10.5" Width="70" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding Title}" Canvas.Top="2" />
                     <TextBlock FontStyle="Italic" FontSize="9.5" Width="70" TextAlignment="Center" Text="{Binding IndexText}" Canvas.Bottom="2" />
                     <Decorator Width="248" Height="78" Canvas.Left="70">
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,3,18,3" Text="{Binding Content}" />
                     </Decorator>
                     <Button Command="{res:MethodCommand Close}" Width="16" Height="16" Canvas.Top="1" Canvas.Right="1">
                        <Path Fill="{DynamicResource Secondary}" Data="{res:Icon Exit}" Stretch="Uniform" />
                     </Button>
                  </Canvas>
               </Border>
            </DataTemplate>
         </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
      <Path Name="Check" Data="{res:Icon Check}" Fill="{DynamicResource Stream2}" Stretch="Uniform" Width="40" Height="40" Opacity="0" Canvas.Top="0" Canvas.Right="0" IsHitTestVisible="False" />
      <Border Canvas.Top="-20" Canvas.Right="0" Height="20" Width="110" Background="{DynamicResource Backlight}" BorderBrush="{DynamicResource Secondary}"
              BorderThickness="1" IsVisible="{Binding #ContentPanel.IsPointerOver}">
         <Border.ContextMenu>
            <ContextMenu>
               <MenuItem Header="Dismiss All" Command="{res:MethodCommand DismissAll}" />
               <MenuItem Header="Restart All" Command="{res:MethodCommand Reset}" />
            </ContextMenu>
         </Border.ContextMenu>
         <TextBlock HorizontalAlignment="Center">
            <Run Text="Tutorials (" /><Run Text="{Binding CompletionPercent, Mode=OneWay}" /><Run Text=")" />
         </TextBlock>
      </Border>
      <Border Canvas.Bottom="0" Canvas.Right="0" Height="20" Width="110" IsVisible="{Binding SeeMore}">
         <Border Background="{DynamicResource Backlight}" BorderBrush="{DynamicResource Secondary}"
                 BorderThickness="1" IsVisible="{Binding #ContentPanel.IsPointerOver}">
            <ToolTip.Tip>
               <TextBlock>
                  Complete actions to clear tutorials.<LineBreak />
                  Additional tutorials will show until you've completed them all.
               </TextBlock>
            </ToolTip.Tip>
            <TextBlock HorizontalAlignment="Center" Text="See More..."/>
         </Border>
      </Border>
   </Canvas>
</UserControl>
